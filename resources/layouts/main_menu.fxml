<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.MainMenuController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-image: url('/images/main_menu_background.png');
             -fx-background-size: cover;
             -fx-background-position: center;">

    <Text text="Color Match Game"
          style="-fx-font-size: 32px; -fx-fill: white;" />

    <Button text="Play Game"
            onAction="#handlePlayGame"
            prefWidth="200"/>

    <Button text="How To Play"
            onAction="#handleHowToPlay"
            prefWidth="200"/>

    <Button text="Settings"
            onAction="#handleSettings"
            prefWidth="200"/>

</VBox>
