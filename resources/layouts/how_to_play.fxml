<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.HowToPlayController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-image: url('/images/background.png');
             -fx-background-size: cover;
             -fx-background-position: center;">

    <Text text="How To Play"
          style="-fx-font-size: 28px; -fx-fill: white;" />

    <ScrollPane fitToWidth="true" prefHeight="400" style="-fx-background: transparent;">
        <content>
            <VBox spacing="10" alignment="TOP_LEFT" style="-fx-padding: 15;">

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="Welcome to the Color Match Card Game! The goal is to be the first player to get rid of all your cards." />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="Each player takes turns placing a card that matches either the color or number of the top card on the discard pile." />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="If you do not have a valid card to play, you must draw a card from the deck." />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="Action Cards:" />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="• Skip: The next player loses their turn." />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="• Reverse: The direction of play is reversed." />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="• Draw Two: The next player draws two cards and loses their turn." />

                <Text wrappingWidth="500"
                      style="-fx-fill: white;"
                      text="The game continues until one player has no cards left. That player is the winner!" />

            </VBox>
        </content>
    </ScrollPane>

    <Button text="Back to Menu"
            onAction="#handleBack"
            prefWidth="150"/>

</VBox>
