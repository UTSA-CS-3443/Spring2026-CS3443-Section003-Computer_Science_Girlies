<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.utsa.cs3443.project_demo.controller.LobbyController"
           prefWidth="900"
           prefHeight="600">

    <ImageView fitWidth="900"
               fitHeight="600"
               preserveRatio="false">
        <image>
            <Image url="@../images/background.png"/>
        </image>
    </ImageView>

    <AnchorPane prefWidth="900"
                prefHeight="600">

        <Text text="Game Lobby"
              layoutX="395"
              layoutY="55"
              style="-fx-font-size: 24px;
                     -fx-fill: white;
                     -fx-font-family: 'Arial Rounded MT Bold';" />

        <VBox layoutX="45"
              layoutY="55"
              alignment="CENTER"
              prefWidth="75"
              prefHeight="75"
              style="-fx-background-color: white;
                     -fx-background-radius: 8;
                     -fx-border-color: black;
                     -fx-border-radius: 8;
                     -fx-border-width: 1;">

            <Text text="😄"
                  style="-fx-font-size: 42px;" />
        </VBox>

        <VBox layoutX="130"
              layoutY="55"
              spacing="8"
              prefWidth="205"
              prefHeight="75"
              style="-fx-background-color: white;
                     -fx-background-radius: 8;
                     -fx-border-color: black;
                     -fx-border-radius: 8;
                     -fx-border-width: 1;
                     -fx-padding: 10;">

            <Text text="Username: abc123"
                  style="-fx-font-size: 16px;
                         -fx-fill: black;" />

            <HBox alignment="CENTER_LEFT"
                  spacing="6">

                <Text text="Lvl 1"
                      style="-fx-font-size: 12px;
                             -fx-fill: black;" />

                <StackPane prefWidth="120"
                           prefHeight="18">

                    <Rectangle width="120"
                               height="18"
                               arcWidth="18"
                               arcHeight="18"
                               fill="white"
                               stroke="black"
                               strokeWidth="1.5" />

                    <Rectangle width="60"
                               height="18"
                               arcWidth="18"
                               arcHeight="18"
                               fill="#6ee75a"
                               translateX="-30" />

                </StackPane>

                <Text text="Lvl 2"
                      style="-fx-font-size: 12px;
                             -fx-fill: black;" />

            </HBox>
        </VBox>

        <HBox layoutX="150"
              layoutY="185"
              spacing="28"
              alignment="CENTER">

            <VBox alignment="CENTER"
                  spacing="10">
                <Text text="Player 1"
                      style="-fx-font-size: 22px; -fx-fill: white; -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #ff2d1f;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58"
                             radiusY="88"
                             fill="white" />
                    <Text text="👤"
                          style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER"
                  spacing="10">
                <Text text="Player 2"
                      style="-fx-font-size: 22px; -fx-fill: white; -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #ffec4f;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58"
                             radiusY="88"
                             fill="white" />
                    <Text text="👤"
                          style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER"
                  spacing="10">
                <Text text="Player 3"
                      style="-fx-font-size: 22px; -fx-fill: white; -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #70ef44;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58"
                             radiusY="88"
                             fill="white" />
                    <Text text="👤"
                          style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER"
                  spacing="10">
                <Text text="Player 4"
                      style="-fx-font-size: 22px; -fx-fill: white; -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #4d83e8;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58"
                             radiusY="88"
                             fill="white" />
                    <Text text="👤"
                          style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

        </HBox>

        <Button text="Add Player"
                onAction="#handleInvite"
                layoutX="150"
                layoutY="500"
                prefWidth="170"
                prefHeight="38"
                style="-fx-font-size: 16px;
                       -fx-background-radius: 12;
                       -fx-background-color: white;
                       -fx-text-fill: black;
                       -fx-font-weight: bold;" />

        <Button text="Start Game"
                onAction="#handleStartGame"
                layoutX="365"
                layoutY="500"
                prefWidth="170"
                prefHeight="38"
                style="-fx-font-size: 16px;
                       -fx-background-radius: 12;
                       -fx-background-color: white;
                       -fx-text-fill: black;
                       -fx-font-weight: bold;" />

        <Button text="Leave Lobby"
                onAction="#handleLeaveLobby"
                layoutX="585"
                layoutY="500"
                prefWidth="170"
                prefHeight="38"
                style="-fx-font-size: 16px;
                       -fx-background-radius: 12;
                       -fx-background-color: white;
                       -fx-text-fill: black;
                       -fx-font-weight: bold;" />

        <!-- Hidden fields kept so LobbyController does not crash -->
        <TextArea fx:id="playerListArea"
                  visible="false"
                  managed="false" />

        <TextField fx:id="playerNameField"
                   visible="false"
                   managed="false" />

    </AnchorPane>

</StackPane>