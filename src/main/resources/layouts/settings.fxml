<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.utsa.cs3443.project_demo.controller.SettingsController"
           prefWidth="900"
           prefHeight="600">

    <ImageView fitWidth="900"
               fitHeight="600"
               preserveRatio="false">
        <image>
            <Image url="@../images/background.png"/>
        </image>
    </ImageView>

    <AnchorPane prefWidth="900"
                prefHeight="600">

        <Button text="Back to Main Menu"
                onAction="#handleBack"
                layoutX="30"
                layoutY="25"
                prefWidth="170"
                prefHeight="35"
                style="-fx-font-size: 14px;
                       -fx-background-radius: 12;
                       -fx-background-color: white;
                       -fx-text-fill: black;
                       -fx-font-weight: bold;" />

        <Text text="Settings"
              layoutX="410"
              layoutY="55"
              style="-fx-font-size: 24px;
                     -fx-fill: white;
                     -fx-font-family: 'Arial Rounded MT Bold';" />

        <ComboBox fx:id="languageBox"
                  layoutX="235"
                  layoutY="85"
                  prefWidth="430"
                  prefHeight="45"
                  style="-fx-background-radius: 12;" />

        <ComboBox fx:id="controlsBox"
                  layoutX="235"
                  layoutY="150"
                  prefWidth="430"
                  prefHeight="45"
                  style="-fx-background-radius: 12;" />

        <ComboBox fx:id="appearanceBox"
                  layoutX="235"
                  layoutY="215"
                  prefWidth="430"
                  prefHeight="45"
                  style="-fx-background-radius: 12;" />

        <ComboBox fx:id="resolutionBox"
                  layoutX="235"
                  layoutY="280"
                  prefWidth="430"
                  prefHeight="45"
                  style="-fx-background-radius: 12;" />

        <CheckBox fx:id="musicCheck"
                  layoutX="235"
                  layoutY="350"
                  text="Music"
                  style="-fx-text-fill: white; -fx-font-size: 16px;" />

        <CheckBox fx:id="sfxCheck"
                  layoutX="235"
                  layoutY="410"
                  text="Sound Effects"
                  style="-fx-text-fill: white; -fx-font-size: 16px;" />

        <CheckBox fx:id="colorblindCheck"
                  layoutX="235"
                  layoutY="470"
                  text="Colorblind Mode"
                  style="-fx-text-fill: white; -fx-font-size: 16px;" />

        <!-- Hidden, kept for SettingsController compatibility -->
        <ComboBox fx:id="displayModeBox"
                  visible="false"
                  managed="false" />

    </AnchorPane>

</StackPane>