<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Ellipse?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.utsa.cs3443.project_demo.controller.GameOverController"
           prefWidth="900"
           prefHeight="600">

    <ImageView fitWidth="900" fitHeight="600" preserveRatio="false">
        <image>
            <Image url="@../images/background.png"/>
        </image>
    </ImageView>

    <AnchorPane prefWidth="900" prefHeight="600">

        <Text text="Game Over"
              layoutX="360"
              layoutY="70"
              style="-fx-font-size: 38px;
                     -fx-fill: white;
                     -fx-font-family: 'Arial Rounded MT Bold';" />

        <HBox layoutX="95"
              layoutY="95"
              spacing="28"
              alignment="CENTER">

            <VBox alignment="CENTER" spacing="8">
                <ImageView fx:id="player1ResultImage"
                           fitWidth="260"
                           fitHeight="130"
                           preserveRatio="true" />

                <Text text="Player 1"
                      style="-fx-font-size: 22px;
                             -fx-fill: white;
                             -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #ff2d1f;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58" radiusY="88" fill="white" />
                    <Text text="👤" style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER" spacing="8">
                <ImageView fx:id="player2ResultImage"
                           fitWidth="260"
                           fitHeight="130"
                           preserveRatio="true" />

                <Text text="Player 2"
                      style="-fx-font-size: 22px;
                             -fx-fill: white;
                             -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #ffec4f;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58" radiusY="88" fill="white" />
                    <Text text="👤" style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER" spacing="8">
                <ImageView fx:id="player3ResultImage"
                           fitWidth="260"
                           fitHeight="130"
                           preserveRatio="true" />

                <Text text="Player 3"
                      style="-fx-font-size: 22px;
                             -fx-fill: white;
                             -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #70ef44;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58" radiusY="88" fill="white" />
                    <Text text="👤" style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

            <VBox alignment="CENTER" spacing="8">
                <ImageView fx:id="player4ResultImage"
                           fitWidth="260"
                           fitHeight="130"
                           preserveRatio="true" />

                <Text text="Player 4"
                      style="-fx-font-size: 22px;
                             -fx-fill: white;
                             -fx-font-family: 'Arial Rounded MT Bold';" />

                <StackPane prefWidth="150"
                           prefHeight="205"
                           style="-fx-background-color: #4d83e8;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #1f2937;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Ellipse radiusX="58" radiusY="88" fill="white" />
                    <Text text="👤" style="-fx-font-size: 60px;" />
                </StackPane>
            </VBox>

        </HBox>

        <Button text="Back to Main Menu"
                onAction="#handleBackToMenu"
                layoutX="335"
                layoutY="500"
                prefWidth="230"
                prefHeight="45"
                style="-fx-background-color: white;
                       -fx-background-radius: 15;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;" />

    </AnchorPane>
</StackPane>