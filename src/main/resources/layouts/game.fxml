<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="edu.utsa.cs3443.project_demo.controller.GameController"
           prefWidth="900"
           prefHeight="600">

    <ImageView fitWidth="900"
               fitHeight="600"
               preserveRatio="false">
        <image>
            <Image url="@../images/background.png"/>
        </image>
    </ImageView>

    <AnchorPane prefWidth="900"
                prefHeight="600">

        <!-- Turn Label -->
        <Text fx:id="turnLabel"
              text="Your Turn"
              layoutX="675"
              layoutY="45"
              wrappingWidth="190"
              textAlignment="CENTER"
              style="-fx-font-size: 20px;
                     -fx-fill: white;
                     -fx-font-family: 'Arial Rounded MT Bold';" />

        <!-- Player 1 -->
        <Label fx:id="player1Label"
               text="Player 1"
               layoutX="35"
               layoutY="390"
               prefWidth="150"
               prefHeight="35"
               alignment="CENTER"
               style="-fx-background-color: white;
                      -fx-background-radius: 12;
                      -fx-border-color: black;
                      -fx-border-radius: 12;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;" />

        <StackPane layoutX="70"
                   layoutY="440"
                   prefWidth="85"
                   prefHeight="85">
            <Rectangle width="85"
                       height="85"
                       arcWidth="12"
                       arcHeight="12"
                       fill="white"
                       stroke="#ff2d1f"
                       strokeWidth="5" />
            <Text text="😄"
                  style="-fx-font-size: 52px;" />
        </StackPane>

        <!-- Player 2 -->
        <Label fx:id="player2Label"
               text="Player 2"
               layoutX="45"
               layoutY="130"
               prefWidth="150"
               prefHeight="35"
               alignment="CENTER"
               style="-fx-background-color: white;
                      -fx-background-radius: 12;
                      -fx-border-color: black;
                      -fx-border-radius: 12;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;" />

        <StackPane layoutX="85"
                   layoutY="180"
                   prefWidth="70"
                   prefHeight="70">
            <Rectangle width="70"
                       height="70"
                       arcWidth="10"
                       arcHeight="10"
                       fill="white"
                       stroke="#ffec4f"
                       strokeWidth="4" />
            <Text text="😉"
                  style="-fx-font-size: 42px;" />
        </StackPane>

        <!-- Player 3 -->
        <Label fx:id="player3Label"
               text="Player 3"
               layoutX="405"
               layoutY="45"
               prefWidth="150"
               prefHeight="35"
               alignment="CENTER"
               style="-fx-background-color: white;
                      -fx-background-radius: 12;
                      -fx-border-color: black;
                      -fx-border-radius: 12;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;" />

        <StackPane layoutX="445"
                   layoutY="95"
                   prefWidth="70"
                   prefHeight="70">
            <Rectangle width="70"
                       height="70"
                       arcWidth="10"
                       arcHeight="10"
                       fill="white"
                       stroke="#70ef44"
                       strokeWidth="4" />
            <Text text="😍"
                  style="-fx-font-size: 42px;" />
        </StackPane>

        <!-- Player 4 -->
        <Label fx:id="player4Label"
               text="Player 4"
               layoutX="705"
               layoutY="130"
               prefWidth="150"
               prefHeight="35"
               alignment="CENTER"
               style="-fx-background-color: white;
                      -fx-background-radius: 12;
                      -fx-border-color: black;
                      -fx-border-radius: 12;
                      -fx-font-size: 18px;
                      -fx-font-weight: bold;" />

        <StackPane layoutX="745"
                   layoutY="180"
                   prefWidth="70"
                   prefHeight="70">
            <Rectangle width="70"
                       height="70"
                       arcWidth="10"
                       arcHeight="10"
                       fill="white"
                       stroke="#4d83e8"
                       strokeWidth="4" />
            <Text text="😎"
                  style="-fx-font-size: 42px;" />
        </StackPane>

        <!-- Draw Button -->
        <Button fx:id="drawButton"
                text="Draw Card"
                onAction="#handleDrawCard"
                layoutX="235"
                layoutY="115"
                prefWidth="120"
                prefHeight="60"
                style="-fx-background-radius: 15;
                       -fx-background-color: black;
                       -fx-text-fill: white;
                       -fx-font-size: 16px;
                       -fx-font-weight: bold;" />

        <!-- Top Card -->
        <Button fx:id="topCardDisplay"
                layoutX="425"
                layoutY="265"
                prefWidth="120"
                prefHeight="170"
                style="-fx-background-color: transparent;" />

        <!-- Human Hand -->
        <HBox fx:id="handContainer"
              layoutX="220"
              layoutY="435"
              spacing="-15"
              alignment="CENTER"
              prefWidth="560"
              prefHeight="140" />

        <!-- Player 2 Hand -->
        <HBox fx:id="player2HandContainer"
              layoutX="120"
              layoutY="285"
              spacing="-28"
              alignment="CENTER" />

        <!-- Player 3 Hand -->
        <HBox fx:id="player3HandContainer"
              layoutX="365"
              layoutY="185"
              spacing="-18"
              alignment="CENTER" />

        <!-- Player 4 Hand -->
        <HBox fx:id="player4HandContainer"
              layoutX="645"
              layoutY="285"
              spacing="-28"
              alignment="CENTER" />

        <!-- Continue Button -->
        <Button fx:id="continueButton"
                text="Continue"
                onAction="#handleContinue"
                layoutX="700"
                layoutY="525"
                prefWidth="150"
                prefHeight="42"
                visible="false"
                style="-fx-background-color: white;
                       -fx-background-radius: 15;
                       -fx-font-size: 18px;
                       -fx-font-weight: bold;" />

    </AnchorPane>

</StackPane>